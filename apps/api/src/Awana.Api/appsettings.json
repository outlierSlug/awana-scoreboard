{
  "Logging": {
    // Every key under LogLevel is bound as a category name and its value as a
    // level, so a "comment" written as a key is parsed as a level and stops the
    // app from starting. Real comments are fine: the JSON configuration
    // provider skips them.
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",

      // EF logs every statement it runs at Information, with the SQL and the
      // parameter list. In production that buries the night's actual traffic
      // under query text and copies data into a log nobody is guarding.
      // appsettings.Development.json already turned this down; the base file
      // did not, so the setting only applied where it was least needed.
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",

      // Startup chatter about key rings, on a platform whose container has no
      // persistent storage to keep them in anyway.
      "Microsoft.AspNetCore.DataProtection": "Warning"
    }
  },
  "AllowedHosts": "*"
}
