# Every environment variable the web app reads. All of them are inlined by Vite
# at build time, so none of them may ever hold a secret. Anything here ships to
# the browser in plain text.
#
# Copy to .env.development.local to override locally without touching the
# committed defaults.

# Origin of the API. No trailing slash.
#   local        http://localhost:5201
#   deployed     https://api.<your-domain>
VITE_API_BASE_URL=http://localhost:5201
